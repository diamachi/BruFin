# Optional. If omitted, BruFin creates a random token in the persistent data volume.
# Retrieve it with: docker compose exec brufin cat /data/api-token
BRUFIN_API_TOKEN=

# Use 0.0.0.0 for LAN access. Use 127.0.0.1 behind a reverse proxy on this host.
BRUFIN_BIND_ADDRESS=0.0.0.0

# One-time first-run setup for a fresh server. Use only on a private LAN/VPN.
# Set false if the server is reachable by people you do not trust.
BRUFIN_ALLOW_FIRST_RUN_PAIRING=true

# Only needed when the Android Capacitor app calls this server from a different origin.
BRUFIN_ALLOWED_ORIGINS=http://localhost,https://localhost,capacitor://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
